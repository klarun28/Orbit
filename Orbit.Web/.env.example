# Copy this file to .env.development (and .env.production) and fill in values.
# All client-exposed variables MUST be prefixed with VITE_.

# Display name of the application.
VITE_APP_NAME=Orbit 2.0

# Base URL of the backend API, including the /api suffix.
# Example: https://localhost:7001/api
# The real URL/port will be provided separately by the backend team.
VITE_API_BASE_URL=
